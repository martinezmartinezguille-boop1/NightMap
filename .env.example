# Copia este archivo a .env y rellena los datos de tu cuenta.
# En Gmail usa una contraseña de aplicación, no la contraseña normal.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
MAIL_FROM="NightMap <tu-correo@gmail.com>"

# Stripe. Usa claves de prueba (sk_test_ / whsec_) hasta validar el cobro.
# La clave secreta solo vive en el servidor. No la pongas con prefijo VITE_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
